<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  PANTALLA PRINCIPAL (HU01).
  BorderPane = cinco zonas: top (arriba), center (centro), bottom (abajo).
  Cada elemento con fx:id lo puede "ver" el controlador por ese nombre.
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.univalle.blackjack.BlackjackController"
            style="-fx-background-color: #2e7d32;">

    <!-- ARRIBA: título, saldo y apuesta vigente -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="40.0" style="-fx-background-color: #1b5e20;">
            <padding>
                <Insets top="12.0" right="20.0" bottom="12.0" left="20.0"/>
            </padding>
            <Label text="21 Black Jack" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label fx:id="lblSaldo" text="Saldo: 0" style="-fx-text-fill: white; -fx-font-size: 18px;"/>
            <Label fx:id="lblApuesta" text="Apuesta: -" style="-fx-text-fill: white; -fx-font-size: 18px;"/>
        </HBox>
    </top>

    <!-- CENTRO: zona del computador, mensajes y zona del jugador -->
    <center>
        <VBox alignment="CENTER" spacing="14.0">
            <padding>
                <Insets top="16.0" right="20.0" bottom="16.0" left="20.0"/>
            </padding>

            <!-- Zona del computador -->
            <Label text="COMPUTADOR" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <HBox fx:id="cartasComputador" alignment="CENTER" spacing="8.0" minHeight="170.0"
                  style="-fx-background-color: #388e3c; -fx-background-radius: 10;"/>
            <Label fx:id="lblPuntajeComputador" text="Puntaje: -" style="-fx-text-fill: white; -fx-font-size: 16px;"/>

            <!-- Mensajes de turno, jugadas y resultado -->
            <Label fx:id="lblMensaje" text="" wrapText="true" textAlignment="CENTER"
                   style="-fx-text-fill: #fff9c4; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <!-- Zona del jugador -->
            <Label text="JUGADOR" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <HBox fx:id="cartasJugador" alignment="CENTER" spacing="8.0" minHeight="170.0"
                  style="-fx-background-color: #388e3c; -fx-background-radius: 10;"/>
            <Label fx:id="lblPuntajeJugador" text="Puntaje: -" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
        </VBox>
    </center>

    <!-- ABAJO: campo de apuesta y botones -->
    <bottom>
        <HBox alignment="CENTER" spacing="12.0" style="-fx-background-color: #1b5e20;">
            <padding>
                <Insets top="14.0" right="20.0" bottom="14.0" left="20.0"/>
            </padding>
            <TextField fx:id="campoApuesta" promptText="Apuesta (múltiplo de 10)" prefWidth="190.0"/>
            <Button fx:id="btnIniciar" text="Iniciar ronda" onAction="#onIniciarRonda"/>
            <Button fx:id="btnPedir" text="Pedir carta"/>
            <Button fx:id="btnPlantarse" text="Plantarse"/>
            <Button fx:id="btnReglas" text="Ver reglas"/>
            <Button fx:id="btnCerrar" text="Cerrar juego"/>
        </HBox>
    </bottom>
</BorderPane>
